generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RankingScope {
  UNIVERSAL
  CATEGORY
}

enum PlacementTier {
  CHAMPION
  RUNNER_UP
  SEMI_FINALIST
  THIRD_PLACE
  FOURTH_PLACE
  ADVANCED_STAGE
  GROUP_STAGE
  PARTICIPATION
}

enum ClubMemberRole {
  OWNER
  ORGANIZER
  MEMBER
}

enum ClubSessionStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ClubSessionVisibility {
  PUBLIC
  MEMBER_ONLY
  ADMIN_ONLY
}

enum ClubAttendanceStatus {
  GOING
  NOT_GOING
}

enum LeagueFormat {
  ROUND_ROBIN
  TEAM_PAIR_MATRIX
  FIXED_DOUBLES
  MANUAL
}

model Player {
  id       String  @id @default(cuid())
  fullName String
  nickname String  @unique
  isActive Boolean @default(true)

  clubId            String?
  clubRole          ClubMemberRole @default(MEMBER)
  clubProfilePublic Boolean        @default(false)
  clubJoinedAt      DateTime?
  clubNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  teamEntriesAsPlayer1 TeamEntry[] @relation("TeamEntryPlayer1")
  teamEntriesAsPlayer2 TeamEntry[] @relation("TeamEntryPlayer2")

  rankingLedgers  RankingLedger[]
  tournamentStats PlayerTournamentStat[]

  sessionAttendance ClubSessionAttendance[]
  leagueTeamPlayers LeagueTeamPlayer[]
  leagueStats       PlayerLeagueStat[]

  @@index([clubId])
  @@index([clubId, isActive])
  @@index([clubId, clubRole])
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  location    String?
  eventDate   DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories    TournamentCategory[]
  teamEntries   TeamEntry[]
  matches       Match[]
  rankingLedger RankingLedger[]
  playerStats   PlayerTournamentStat[]
}

model TournamentCategory {
  id                 String  @id @default(cuid())
  tournamentId       String
  name               String
  code               String
  rulesSummary       String?
  knockoutStartStage String?
  knockoutConfig     Json?

  tournament  Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stages      Stage[]
  teamEntries TeamEntry[]
  matches     Match[]
  playerStats PlayerTournamentStat[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rankingLedgers RankingLedger[]

  @@unique([tournamentId, code])
}

model Stage {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  stageType  String
  stageOrder Int
  configJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groups   Group[]
  matches  Match[]

  @@unique([categoryId, stageOrder])
}

model TeamEntry {
  id           String   @id @default(cuid())
  tournamentId String
  categoryId   String
  player1Id    String
  player2Id    String
  teamName     String?
  seedNumber   Int?
  status       String   @default("registered")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament       Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category         TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  player1          Player             @relation("TeamEntryPlayer1", fields: [player1Id], references: [id], onDelete: Restrict)
  player2          Player             @relation("TeamEntryPlayer2", fields: [player2Id], references: [id], onDelete: Restrict)
  groupMemberships GroupMembership[]
  homeMatches      Match[]            @relation("MatchTeamA")
  awayMatches      Match[]            @relation("MatchTeamB")
  wonMatches       Match[]            @relation("MatchWinner")
}

model Group {
  id         String   @id @default(cuid())
  stageId    String
  name       String
  groupOrder Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stage       Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  matches     Match[]

  @@unique([stageId, name])
  @@unique([stageId, groupOrder])
}

model GroupMembership {
  id          String   @id @default(cuid())
  groupId     String
  teamEntryId String
  createdAt   DateTime @default(now())

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamEntry TeamEntry @relation(fields: [teamEntryId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamEntryId])
}

model Match {
  id           String    @id @default(cuid())
  tournamentId String
  categoryId   String
  stageId      String
  groupId      String?
  roundLabel   String?
  teamAId      String?
  teamBId      String?
  winnerId     String?
  status       String    @default("scheduled")
  scheduledAt  DateTime?
  scoreSummary String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stage      Stage              @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group      Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teamA      TeamEntry?         @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB      TeamEntry?         @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  winner     TeamEntry?         @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  sets       MatchSet[]
}

model MatchSet {
  id         String   @id @default(cuid())
  matchId    String
  setNumber  Int
  teamAScore Int
  teamBScore Int
  createdAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

model RankingLedger {
  id                 String        @id @default(cuid())
  playerId           String
  tournamentId       String
  categoryId         String
  scope              RankingScope
  categoryCode       String
  placementTier      PlacementTier
  basePoints         Int
  multiplierApplied  Decimal       @db.Decimal(5, 2)
  totalPointsAwarded Int
  notes              String?
  createdAt          DateTime      @default(now())

  player     Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([playerId, scope])
  @@index([categoryId, scope])
  @@index([tournamentId])
}

model PlayerTournamentStat {
  id            String        @id @default(cuid())
  playerId      String
  tournamentId  String
  categoryId    String
  teamEntryId   String?
  placementTier PlacementTier
  finishLabel   String?
  matchesPlayed Int           @default(0)
  matchesWon    Int           @default(0)
  setsWon       Int           @default(0)
  setsLost      Int           @default(0)
  pointsFor     Int           @default(0)
  pointsAgainst Int           @default(0)
  rankingPoints Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  player     Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId, categoryId])
  @@index([categoryId, placementTier])
  @@index([tournamentId])
}

model Club {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  shortName           String?
  description         String?
  homeVenue           String?
  logoUrl             String?
  bannerUrl           String?
  isPublic            Boolean  @default(true)
  isManagedClub       Boolean  @default(false)
  memberAccessEnabled Boolean  @default(false)
  memberShareKey      String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  players       Player[]
  sessions      ClubSession[]
  hostedLeagues League[]

  @@index([slug])
  @@index([isPublic])
  @@index([isManagedClub])
}

model ClubSession {
  id            String                @id @default(cuid())
  clubId        String
  title         String
  startAt       DateTime
  endAt         DateTime
  courtNumbers  String?
  status        ClubSessionStatus     @default(SCHEDULED)
  visibility    ClubSessionVisibility @default(MEMBER_ONLY)
  publicNotes   String?
  privateNotes  String?
  costPerPlayer Decimal?              @db.Decimal(8, 2)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  club       Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  attendance ClubSessionAttendance[]

  @@index([clubId, startAt])
  @@index([status])
}

model ClubSessionAttendance {
  id        String               @id @default(cuid())
  sessionId String
  playerId  String
  status    ClubAttendanceStatus @default(NOT_GOING)
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  session ClubSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId, status])
}

model League {
  id         String       @id @default(cuid())
  title      String
  slug       String       @unique
  playedAt   DateTime
  location   String?
  format     LeagueFormat
  rulesNote  String?
  hostClubId String?
  isPublic   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  hostClub    Club?              @relation(fields: [hostClubId], references: [id], onDelete: SetNull)
  teams       LeagueTeam[]
  matches     LeagueMatch[]
  playerStats PlayerLeagueStat[]

  @@index([playedAt])
  @@index([hostClubId])
}

model LeagueTeam {
  id          String   @id @default(cuid())
  leagueId    String
  name        String
  shortName   String?
  teamOrder   Int
  originLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  players        LeagueTeamPlayer[]
  playerStats    PlayerLeagueStat[]
  matchesAsTeamA LeagueMatch[]      @relation("LeagueMatchTeamA")
  matchesAsTeamB LeagueMatch[]      @relation("LeagueMatchTeamB")
  wonMatches     LeagueMatch[]      @relation("LeagueMatchWinner")

  @@unique([leagueId, teamOrder])
  @@index([leagueId])
}

model LeagueTeamPlayer {
  id       String  @id @default(cuid())
  teamId   String
  playerId String
  role     String?

  team   LeagueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([teamId, playerId])
  @@index([playerId])
}

model LeagueMatch {
  id           String    @id @default(cuid())
  leagueId     String
  teamAId      String?
  teamBId      String?
  winnerTeamId String?
  matchOrder   Int
  roundLabel   String?
  scoreSummary String?
  scheduledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  league     League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamA      LeagueTeam? @relation("LeagueMatchTeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB      LeagueTeam? @relation("LeagueMatchTeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  winnerTeam LeagueTeam? @relation("LeagueMatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  sets       LeagueSet[]

  @@unique([leagueId, matchOrder])
  @@index([leagueId])
}

model LeagueSet {
  id         String   @id @default(cuid())
  matchId    String
  setNumber  Int
  teamAScore Int
  teamBScore Int
  createdAt  DateTime @default(now())

  match LeagueMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

model PlayerLeagueStat {
  id       String  @id @default(cuid())
  playerId String
  leagueId String
  teamId   String?

  matchesPlayed Int @default(0)
  matchesWon    Int @default(0)
  matchesLost   Int @default(0)
  pointsFor     Int @default(0)
  pointsAgainst Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   LeagueTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([playerId, leagueId])
  @@index([leagueId])
  @@index([teamId])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
